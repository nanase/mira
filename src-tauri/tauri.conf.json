{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mira",
  "version": "0.3.0",
  "identifier": "dev.mira.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "Mira",
        "url": "popover.html",
        "width": 340,
        "height": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Claude の使用量制限をタスクトレイに表示する",
    "copyright": "Copyright (c) 2026 nanase"
  }
}
